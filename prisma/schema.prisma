generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Slice 1.3 — Schema v1 (spec §9, ADR-0002). Only the four models listed
// for this slice; later-slice models are intentionally NOT added yet.

enum Role {
  ADMIN
  COORDINATOR
}

enum PreferredLanguage {
  en
  ta
  hi
}

enum PlanStatus {
  DRAFT
  INVITED
  BENEFICIARY_ACCEPTED
  REVISION_PROPOSED
  COORDINATOR_ACKNOWLEDGED
  BENEFICIARY_DECLINED_TO_SHARE
  NO_RESPONSE
  CLOSED
}

enum PaymentStatus {
  NOT_SENT
  READY
  SUBMITTING
  STATUS_UNKNOWN
  PENDING
  PROCESSING
  SUCCESS
  DENIED
  FAILED
  UNCLAIMED
  RETURNED
  ON_HOLD
  BLOCKED
  REFUNDED
  REVERSED
}

enum PaymentMode {
  SANDBOX
  MOCK
}

enum ActorType {
  COORDINATOR
  BENEFICIARY
  SYSTEM
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  users         User[]
  beneficiaries Beneficiary[]
  disbursements Disbursement[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model User {
  id                       String         @id @default(cuid())
  organizationId           String?
  organization             Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name                     String
  email                    String         @unique
  emailVerified            Boolean        @default(false)
  image                    String?
  passwordHash             String?
  role                     Role           @default(COORDINATOR)
  coordinatedDisbursements Disbursement[] @relation("DisbursementCoordinator")
  sessions                 Session[]
  accounts                 Account[]
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@index([organizationId])
}

model Beneficiary {
  id                       String            @id @default(cuid())
  organizationId           String
  organization             Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  displayName              String
  invitationEmail          String
  encryptedPayPalRecipient String
  preferredLanguage        PreferredLanguage
  disbursements            Disbursement[]
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([organizationId])
}

model Disbursement {
  id                              String        @id @default(cuid())
  publicReference                 String        @unique
  organizationId                  String
  organization                    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  coordinatorId                   String
  coordinator                     User          @relation("DisbursementCoordinator", fields: [coordinatorId], references: [id], onDelete: Restrict)
  beneficiaryId                   String
  beneficiary                     Beneficiary   @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  amountMinor                     BigInt
  currency                        String        @default("USD")
  supportNote                     String        @db.Text
  shareSupportNoteWithBeneficiary Boolean       @default(false)
  planStatus                      PlanStatus    @default(DRAFT)
  paymentStatus                   PaymentStatus @default(NOT_SENT)
  paypalPayoutBatchId             String?
  paypalPayoutItemId              String?
  paypalBatchStatus               String?
  paypalItemStatus                String?
  paymentMode                     PaymentMode   @default(SANDBOX)
  planVersions                    PlanVersion[]
  ledgerEvents                    LedgerEvent[]
  createdAt                       DateTime      @default(now())
  updatedAt                       DateTime      @updatedAt

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, paymentStatus])
  @@index([organizationId, planStatus])
}

// Slice 2.7 — PlanVersion is an immutable snapshot (no updatedAt).
model PlanVersion {
  id                  String       @id @default(cuid())
  disbursementId      String
  disbursement        Disbursement @relation(fields: [disbursementId], references: [id], onDelete: Restrict)
  versionNumber       Int
  createdByType       ActorType
  createdById         String?
  summary             String
  status              String       @default("DRAFT")
  totalAllocatedMinor BigInt
  unallocatedMinor    BigInt
  requiresClarification Boolean    @default(false)
  items               PlanItem[]
  createdAt           DateTime     @default(now())

  @@unique([disbursementId, versionNumber])
  @@index([disbursementId])
}

model PlanItem {
  id            String      @id @default(cuid())
  planVersionId String
  planVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  category      String
  description   String?
  amountMinor   BigInt?
  sourceText    String?
  sortOrder     Int         @default(0)

  @@index([planVersionId])
}

// Append-only from application code (spec §9). No update/delete API.
model LedgerEvent {
  id             String       @id @default(cuid())
  disbursementId String
  disbursement   Disbursement @relation(fields: [disbursementId], references: [id], onDelete: Restrict)
  actorType      ActorType
  actorId        String?
  eventType      String
  payloadJson    String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([disbursementId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
