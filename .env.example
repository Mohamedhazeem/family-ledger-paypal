# Copy to .env.local and fill real values. Never commit .env.local
# Canonical names per spec §24 + PORT for Render.

NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=
DATABASE_URL=postgresql://user:password@localhost:5432/family_ledger
APP_ENCRYPTION_KEY=
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
AG_STUDIO_LICENSE_KEY=
AG_STUDIO_AI_PROVIDER=
AG_STUDIO_AI_API_KEY=
# Optional: model IDs offered in AG Studio agent picker (comma-separated, e.g. gpt-4o-mini,gpt-4o)
OPENAI_MODELS=
DEMO_MODE=true
PORT=10000
