{
  "info": {
    "_postman_id": "familyledger-payout-flow",
    "name": "FamilyLedger — Payout Flow (sandbox)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Sign in (coordinator)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{ \"email\": \"{{coordinatorEmail}}\", \"password\": \"{{coordinatorPassword}}\" }"
        },
        "url": { "raw": "{{appUrl}}/api/auth/sign-in/email", "host": ["{{appUrl}}"], "path": ["api", "auth", "sign-in", "email"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('sign-in returns 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Create disbursement",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"beneficiary\": { \"displayName\": \"Postman Demo\", \"invitationEmail\": \"postman.demo@example.com\", \"payPalRecipientEmail\": \"postman.demo.paypal@example.com\", \"preferredLanguage\": \"en\" },\n  \"amountText\": \"500.00\",\n  \"currency\": \"USD\",\n  \"supportNote\": \"Postman collection flow.\",\n  \"plan\": { \"summary\": \"Postman\", \"items\": [{ \"category\": \"Rent\", \"amountText\": \"300.00\" }] }\n}"
        },
        "url": { "raw": "{{appUrl}}/api/disbursements", "host": ["{{appUrl}}"], "path": ["api", "disbursements"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('create returns 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.variables.set('disbursementId', body.id);",
              "pm.variables.set('publicReference', body.publicReference);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Submit payout (one sandbox batch)",
      "request": {
        "method": "POST",
        "header": [],
        "body": { "mode": "raw", "raw": "" },
        "url": {
          "raw": "{{appUrl}}/api/disbursements/{{disbursementId}}/pay",
          "host": ["{{appUrl}}"],
          "path": ["api", "disbursements", "{{disbursementId}}", "pay"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('submit returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(body.paypalPayoutBatchId).to.not.be.null;",
              "pm.variables.set('payoutBatchId', body.paypalPayoutBatchId);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Refresh payout status (batch + item)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{appUrl}}/api/disbursements/{{disbursementId}}/payout-status",
          "host": ["{{appUrl}}"],
          "path": ["api", "disbursements", "{{disbursementId}}", "payout-status"],
          "variable": [{ "key": "disbursementId", "value": "{{disbursementId}}" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status refresh returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(body.paypalPayoutBatchId).to.eql(pm.variables.get('payoutBatchId'));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "appUrl", "value": "http://localhost:3000" },
    { "key": "coordinatorEmail", "value": "alex.morgan@example.com" },
    { "key": "coordinatorPassword", "value": "DemoPass123!" },
    { "key": "disbursementId", "value": "" },
    { "key": "publicReference", "value": "" },
    { "key": "payoutBatchId", "value": "" }
  ]
}
